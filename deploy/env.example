NEXT_PUBLIC_SUPABASE_URL=your-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=your-url
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-key
SUPABASE_JWT_ALGORITHMS=ES256,RS256,HS256
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# Optional override; defaults to SUPABASE_URL/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Legacy HS256 migrations only; asymmetric signing keys are preferred.
SUPABASE_JWT_SECRET=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
ZONEPILOT_DB_URL=postgres://postgres:postgres@localhost:5432/postgres
ZONEPILOT_DATA_ROOT=/mounted/zonepilot-data
ZONEPILOT_ENV=local
ZONEPILOT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
ZONEPILOT_RATE_LIMIT_ENABLED=true
ZONEPILOT_AUTH_RATE_LIMIT_PER_MINUTE=10
ZONEPILOT_API_RATE_LIMIT_PER_MINUTE=120
ZONEPILOT_EXPENSIVE_RATE_LIMIT_PER_MINUTE=20
ZONEPILOT_METRICS_ENABLED=false
ZONEPILOT_METRICS_TOKEN=replace-with-platform-secret
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
